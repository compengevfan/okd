additionalTrustBundlePolicy: Proxyonly
apiVersion: v1
baseDomain: okd.evorigin.com
compute:
- architecture: amd64
  hyperthreading: Enabled
  name: worker
  platform: {}
  replicas: 3
controlPlane:
  architecture: amd64
  hyperthreading: Enabled
  name: master
  platform: {}
  replicas: 3
metadata:
  name: avrora
networking:
  clusterNetwork:
  - cidr: 10.128.0.0/14
    hostPrefix: 23
  machineNetwork:
  - cidr: 10.0.0.0/16
  networkType: OVNKubernetes
  serviceNetwork:
  - 172.30.0.0/16
platform:
  baremetal:
    apiVIPs:
    - 10.0.0.10
    bootstrapProvisioningIP: 172.22.0.2
    clusterProvisioningIP: 172.22.0.3
    dnsRecordsType: Internal
    externalBridge: baremetal
    externalMACAddress: 52:54:00:56:5e:d1
    hosts:
    - bmc:
        address: ipmi://192.168.0.1
        disableCertificateVerification: false
        password: blah
        username: blah
      bootMACAddress: "02:00:00:00:00:01"
      bootMode: UEFI
      hardwareProfile: default
      name: okd-avrora-cp1
      role: master
    - bmc:
        address: ipmi://192.168.0.2
        disableCertificateVerification: false
        password: blah
        username: blah
      bootMACAddress: "02:00:00:00:00:02"
      bootMode: UEFI
      hardwareProfile: default
      name: okd-avrora-cp2
      role: master
    - bmc:
        address: ipmi://192.168.0.3
        disableCertificateVerification: false
        password: blah
        username: blah
      bootMACAddress: "02:00:00:00:00:03"
      bootMode: UEFI
      hardwareProfile: default
      name: okd-avrora-cp3
      role: master
    - bmc:
        address: ipmi://192.168.0.4
        disableCertificateVerification: false
        password: blah
        username: "02:00:00:00:00:04"
      bootMACAddress: "02:00:00:00:00:04"
      bootMode: UEFI
      hardwareProfile: default
      name: okd-avrora-wk1
      role: worker
    - bmc:
        address: ipmi://192.168.0.5
        disableCertificateVerification: false
        password: blah
        username: blah
      bootMACAddress: "02:00:00:00:00:05"
      bootMode: UEFI
      hardwareProfile: default
      name: okd-avrora-wk2
      role: worker
    - bmc:
        address: ipmi://192.168.0.6
        disableCertificateVerification: false
        password: blah
        username: blah
      bootMACAddress: "02:00:00:00:00:06"
      bootMode: UEFI
      hardwareProfile: default
      name: okd-avrora-wk3
      role: worker
    ingressVIPs:
    - 10.0.0.11
    libvirtURI: qemu:///system
    provisioningBridge: provisioning
    provisioningDHCPRange: 172.22.0.10,172.22.0.254
    provisioningMACAddress: 52:54:00:3a:7f:f4
    provisioningNetwork: Managed
    provisioningNetworkCIDR: 172.22.0.0/24
    provisioningNetworkInterface: ""
publish: External
pullSecret: [pullsecret]
